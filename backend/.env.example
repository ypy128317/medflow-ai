# SQLite (default)
DATABASE_URL=sqlite:///./medflow.db

# PostgreSQL
# DATABASE_URL=postgresql+psycopg://medflow:medflow@localhost:5432/medflow

# Required in production: use a long random value.
JWT_SECRET=replace-with-a-64-byte-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

MEDFLOW_DEMO_PASSWORD=medflow2026
# Blank = use the current date (seed data shifts automatically)
MEDFLOW_DEMO_DATE=
MEDFLOW_DEMO_NOW=

# Reset and reseed on startup (never enable in production).
MEDFLOW_RESET_DB=0

# Qwen / DashScope OpenAI-compatible mode
# Copy this file to backend/.env, paste your key, restart the API.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT=25

